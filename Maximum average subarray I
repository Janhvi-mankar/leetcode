
class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        int sum = 0;
        int maxSum;

        for (int i = 0; i < k; i++) {
            sum = sum + nums[i];
        }

        maxSum = sum;

        for (int i = k; i < nums.size(); i++) {
            sum = sum + nums[i] - nums[i - k];

            if (sum > maxSum) {
                maxSum = sum;
            }
        }

        return (double)maxSum / k;
    }
};
